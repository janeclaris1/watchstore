# Database — Neon Postgres (works with Prisma on Hostinger)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Public site URL (used by robots.txt / sitemap; set to https://cosyaura.us in production)
NEXT_PUBLIC_SITE_URL="https://cosyaura.us"

# Set to true to put the storefront in maintenance mode (admin stays available)
MAINTENANCE_MODE="false"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Required for embedded Checkout in the browser (same value as STRIPE_PUBLISHABLE_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# EasyPost — live Aramex / DHL / FedEx rates (connect carriers in EasyPost dashboard)
EASYPOST_API_KEY=""
SHIP_FROM_NAME="COSY AURA WATCH STORE"
SHIP_FROM_STREET1="1 Market St"
SHIP_FROM_CITY="San Francisco"
SHIP_FROM_STATE="CA"
SHIP_FROM_ZIP="94105"
SHIP_FROM_COUNTRY="US"
SHIP_FROM_PHONE="4155550100"
SHIP_FROM_EMAIL="shipping@cosyaura.us"
# Watch parcel defaults (inches / pounds)
SHIP_PARCEL_LENGTH="8"
SHIP_PARCEL_WIDTH="6"
SHIP_PARCEL_HEIGHT="4"
SHIP_PARCEL_WEIGHT="1.5"

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID="your-app-id"
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="your-search-only-key"
ALGOLIA_ADMIN_KEY="your-admin-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email notifications (Resend) — REQUIRED on production for order emails
# Domain in EMAIL_FROM must be verified in Resend (cosyaura.us is fine once verified)
RESEND_API_KEY="re_..."
EMAIL_FROM="COSY AURA WATCH STORE <orders@cosyaura.us>"
ADMIN_NOTIFICATION_EMAIL="admin@cosyaura.us"
# Set true only for local UI testing without sending real mail
# EMAIL_DEV_LOG="true"

