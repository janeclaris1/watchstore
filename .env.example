# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Public site URL (used by robots.txt / sitemap; set to https://cosyaura.us in production)
NEXT_PUBLIC_SITE_URL="https://cosyaura.us"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID="your-app-id"
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="your-search-only-key"
ALGOLIA_ADMIN_KEY="your-admin-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email notifications (Resend) — optional; without this, emails log to console
RESEND_API_KEY=""
EMAIL_FROM="COSY AURA WATCH STORE <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL="admin@cosyaurawatchstore.com"
