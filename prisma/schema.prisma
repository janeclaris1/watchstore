generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  UNWORN
  EXCELLENT
  GOOD
}

enum Movement {
  AUTOMATIC
  MANUAL
  QUARTZ
}

enum CaseMaterial {
  STEEL
  GOLD
  PLATINUM
  TWO_TONE
  TITANIUM
  CERAMIC
}

enum StrapMaterial {
  METAL
  LEATHER
  RUBBER
  FABRIC
}

enum Gender {
  MENS
  WOMENS
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  wishlist WishlistItem[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watches Watch[]
  series  Series[]
}

model Series {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  brandId   String   @db.ObjectId
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  watches Watch[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([slug])
}

model Watch {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  slug            String        @unique
  brandId         String        @db.ObjectId
  seriesId        String?       @db.ObjectId
  model           String
  reference       String
  description     String
  conditionReport String?
  price           Float
  condition       Condition
  year            Int?
  movement        Movement
  caseMaterial    CaseMaterial
  caseSize        String?
  strapMaterial   StrapMaterial
  dial            String?
  waterResistance String?
  gender          Gender        @default(UNISEX)
  hasBox          Boolean       @default(false)
  hasPapers       Boolean       @default(false)
  featured        Boolean       @default(false)
  category        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id])
  series        Series?        @relation(fields: [seriesId], references: [id])
  images        WatchImage[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([brandId])
  @@index([seriesId])
  @@index([condition])
  @@index([price])
  @@index([createdAt])
  @@index([featured])
}

model WatchImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  watchId   String   @db.ObjectId
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
}

model Order {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?     @db.ObjectId
  email            String
  status           OrderStatus @default(PENDING)
  total            Float
  stripeSessionId  String?     @unique
  stripePaymentId  String?
  shippingName     String?
  shippingAddress  String?
  shippingCity     String?
  shippingPostcode String?
  shippingCountry  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  orderId  String @db.ObjectId
  watchId  String @db.ObjectId
  price    Float
  quantity Int    @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id])

  @@index([orderId])
  @@index([watchId])
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  watchId   String   @db.ObjectId
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([userId, watchId])
  @@index([userId])
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}

model AdminNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  title     String
  message   String
  link      String?
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
  @@index([orderId])
}

model ContactEnquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
}
